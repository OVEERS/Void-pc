# Скопируй в .env и заполни. Файл .env НИКОГДА не коммитится (он в .gitignore).

# Telegram (этап 2)
TELEGRAM_BOT_TOKEN=
# Через запятую: ID людей, которым разрешено управлять ПК
TELEGRAM_ALLOWED_IDS=
# Необязательно: прокси, если Telegram без него недоступен (http://host:port или socks5://host:port)
TELEGRAM_PROXY=

# Облачный кодер (этап 7), любой OpenAI-совместимый провайдер
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_MODEL=
